<%- include('./partials/_header') %>

<link rel="stylesheet" href="/css/error_ca.css">

<audio id="screenSound" src="/sounds/error.mp3"></audio>


<div class="game-container">
    <!-- Botón de Regresar -->
    <a href="/settingCA">
        <img src="/img/back-icon.png" alt="Regresar" class="back-button" />
    </a>

    <!-- Título de la pantalla -->
    <h1>¡UPS!</h1>

    <div class="difficulty-menu">
        <img src="/img/monitoTriste.png" alt="Monito Triste" class="img" />
        <h2>Inténtalo de Nuevo</h2>
        <h3><strong></strong> <span id="output">...</span></h3>
    </div>

    <div class="button-container">
        <!-- Botón para Reintentar -->
        <button class="again-button" id="againButton" onclick="repeat()">Reintentar</button>
        <!-- Botón para Siguiente -->
        <button class="start-button" id="startButton" onclick="changeButton()">Siguiente</button>
    </div>
</div>

<script src="/js/error_ca.js"></script>

<%- include('./partials/_footer') %>
