<%- include('./partials/_header') %>

    <link rel="stylesheet" href="/css/totis.css" />

    <div class="game-container">
        <!-- Botón de regreso en la parte superior izquierda -->
        <a href="/settingTotis">
            <img src="/img/back-icon.png" alt="Regresar" class="back-button" />
        </a>

        <!-- Tablero -->
        <div class="grid">
            <% for (let row=0; row < 9; row++) { %>
                <!-- 6 filas -->
                <% for (let col=0; col < 6; col++) { %>
                    <!-- 9 columnas -->
                    <div class="cell" data-row="<%= row %>" data-col="<%= col %>">
                        <% if (row===playerRow && col===playerCol) { %>
                            <img src="/img/player.png" alt="Jugador" class="player" />
                            <% } else if (row===totisRow && col===totisCol) { %>
                                <img src="/img/totis.png" alt="Totis" class="totis" />
                                <% } %>
                    </div>
                    <% } %>
                        <% } %>
        </div>

        <!-- Menú de movimientos (Abajo) -->
        <% const movements=['up', 'down' , 'left' , 'right' ]; %>
            <div class="movement-menu">
                <% movements.forEach((move)=> { %>
                    <div class="movement-wrapper">
                        <div class="movement-card" draggable="true" data-move="<%= move %>">
                            <img src="/img/<%= move %>.png" alt="<%= move %>" />
                        </div>
                        <span class="remaining" data-move="<%= move %>">0</span>
                    </div>
                    <% }) %>
            </div>
    </div>

    <script src="/js/totis.js"></script>

    <%- include('./partials/_footer') %>