<%- include('./partials/_header') %>

<link rel="stylesheet" href="/css/setting_ca.css">

<audio id="screenSound" src="/sounds/soap.mp3"></audio>


<div class="game-container">
    <!-- Botón de Regresar -->
    <a href="/panelDeJuegos">
        <img src="/img/back-icon.png" alt="Regresar" class="back-button" />
    </a>

    <!-- Título de la pantalla -->
    <h1>¿Cuál es la Palabra?</h1>

    <h4>En este juego, los niños verán
        una frase con una palabra
        faltante y una imagen que
        representa la palabra que falta.
        Su tarea es decir en voz alta la
        frase completa, si necesitas ayuda toca la imagen.</h4>

    <!-- Menú de selección de dificultad -->
    <div class="difficulty-menu">
        <h2>Número de Oraciones: </h2>
        <div style="display: flex; align-items: center;">
            <button class="level-button" onclick="decreaseNumber()">-</button>
            <input id="numberInput" type="number" value="1" min="1" max="10" />
            <button class="level-button" onclick="increaseNumber()">+</button>
        </div>
        <h3>Max 10</h3>
    </div>

    <!-- Menú de selección de dificultad -->
    <div class="difficulty-menu">
        <h2>Nivel: </h2>
        <button class="difficulty-button" data-difficulty="easy">Fácil</button>
        <button class="difficulty-button" data-difficulty="normal">Normal</button>
        <button class="difficulty-button" data-difficulty="hard">Difícil</button>
    </div>

    <!-- Botón para Iniciar el Juego -->
    <button class="start-button" onclick="startGame()">Iniciar</button>
</div>

<!-- <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> -->
<script src="/js/setting_ca.js"></script>

<%- include('./partials/_footer') %>
