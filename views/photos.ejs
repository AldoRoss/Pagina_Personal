<!DOCTYPE html>
<html lang="es">
<%- include('./partials/_header') %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photos</title>
    <link rel="icon" href="/images/Logo-Compress.png" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css2?family=Halant:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/photos.css"> <!-- Ruta correcta a tu CSS -->
</head>
<body>
    <div class="container">   
        <div class="gallery">
            <!-- Foto 1 -->
            <div class="card">
                <img src="/images/Letras Aldo.jpg" alt="Letras Aldo">
                <div class="card__content">
                    <p class="card__title">ESCOM</p>
                    <p class="card__description">El último dia como estudiante de la ESCOM</p>
                </div>
            </div>

            <!-- Foto 2 -->
            <div class="card">
                <img src="/images/Expo Escom.jpg" alt="Diseño Creativo">
                <div class="card__content">
                    <p class="card__title">EXPO ESCOM 2024</p>
                    <p class="card__description">Participación en la expo escom 2024 con el trabajo BDOF por parte de la materia Ingeniería de software.</p>
                </div>
            </div>

            <!-- Foto 3 -->
            <div class="card">
                <img src="/images/Graduado.jpg" alt="Arte Tipográfico">
                <div class="card__content">
                    <p class="card__title">Graduación</p>
                    <p class="card__description">Foto generacional de la carrera de Inteligencia Artificial 2021-2025.</p>
                </div>
            </div>

            <!-- Foto 4 -->
            <div class="card">
                <img src="/images/TT.jpg" alt="Composición Visual">
                <div class="card__content">
                    <p class="card__title">TT2</p>
                    <p class="card__description">Presenctación del trabajo terminal Quizcraf evaluador de reactivos para unidades de liderazgo.</p>
                </div>
            </div>

            <!-- Foto 5 -->
            <div class="card">
                <img src="/images/primer.jpg" alt="Estilo Personal">
                <div class="card__content">
                    <p class="card__title">Primer día</p>
                    <p class="card__description">Entusiasmado de asistir por primera vez a la universidad, animado por esta nueva aventura.</p>
                </div>
            </div>

            <!-- Foto 6 -->
            <div class="card">
                <img src="/images/Servicio.jpg" alt="Expresión Artística">
                <div class="card__content">
                    <p class="card__title">Servicio Social</p>
                    <p class="card__description">Asistencia y colaboración en conferencias de la ESCOM.</p>
                </div>
            </div>
        </div>

    </div>


<%- include('./partials/_footer') %>

