<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- logo ico -->
    <link rel="icon" href="/images/Logo-Compress.png" type="image/x-icon" />
    <title>Aldo Rosales | Ing. en Soluciones Tecnológicas</title>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <!-- SweetAlert CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- CDN Bootstrap icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

<header class="header">
    <div class="header-container">
        <img src="/images/Logo-Compress.png" alt="Logo" class="header-logo">
        <button class="hamburger" id="hamburger-menu-btn">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav class="nav-menu" id="nav-links">
            <a href="/home" class="nav-link">Inicio</a>
            <a href="/information" class="nav-link">Información</a>
            <a href="/projects" class="nav-link">Proyectos</a>
            <a href="/photos" class="nav-link">Fotos</a>
        </nav>
    </div>
</header>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
    /* Estilos para el header */
    .header {
    width: 100%;
    background-color: #fff;
    position: fixed;
    top: 0;
    left: 0;
    padding: 10px 0;
    box-shadow: 0 2px 12px rgba(33, 53, 85, 0.1);
    z-index: 1000;
    }

    /* Contenedor del header */
    .header-container {
    display: flex;
    justify-content: space-between; /* Separa el logo y los enlaces */
    align-items: center;
    width: 90%;      /* Ancho del contenido */
    margin: 0 auto;  /* Centrar en la pantalla */
    }

    /* Logo */
    .header-logo {
    width: 80px; /* Ajusta el tamaño del logo */
    height: auto;
    }

    /* Menú de navegación */
    .nav-menu {
    display: flex;
    gap: 40px;
    align-items: center;
    }

    /* Estilos de los enlaces */
    .nav-link {
    text-decoration: none;
    color: #213555; /* Color del texto */
    font-size: 22px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    transition: color 0.3s ease;
    }

    .nav-link:hover {
    color: #F95454; /* Cambia de color al pasar el mouse */
    transform: translateY(-5px);
    }

    .nav-link.active-link {
    color: #F95454; /* Salmon color */
    font-weight: 700; 
}

    /* Estilos para el botón de hamburguesa (oculto en escritorio) */
.hamburger {
    display: none; /* Oculto por defecto */
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.hamburger .bar {
    display: block;
    width: 25px;
    height: 3px;
    background-color: #213555;
    margin: 5px 0;
    transition: all 0.3s ease-in-out;
}

/* Estilos responsivos */
@media screen and (max-width: 768px) {
    .header-container {
        justify-content: space-between;
    }

    .nav-menu {
        display: none;
        flex-direction: column;
        width: 100%;
        position: absolute;
        top: 64px;
        left: 0;
        background-color: #fff;
        box-shadow: 0 4px 12px rgba(33, 53, 85, 0.1);
        text-align: center;
        padding: 16px 0;
        z-index: 999;
        gap: 0;
    }

    .nav-menu.active {
        display: flex;
    }

    .nav-link {
        padding: 12px 0;
        font-size: 22px;
        border-bottom: 1px solid #F5EFE7;
    }

    .nav-link:last-child {
        border-bottom: none;
    }

    .hamburger {
        display: block;
    }
}

@media screen and (max-width: 480px) {
    .header-logo {
        width: 60px;
    }

    .nav-link {
        font-size: 20px;
    }
}

</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const hamburgerBtn = document.getElementById('hamburger-menu-btn');
        const navLinks = document.getElementById('nav-links');

        hamburgerBtn.addEventListener('click', function () {
            navLinks.classList.toggle('active');
        });

        // Cerrar menú al hacer click en un enlace (móvil)
        const links = navLinks.getElementsByTagName('a');
        for (let i = 0; i < links.length; i++) {
            links[i].addEventListener('click', function () {
                navLinks.classList.remove('active');
            });
        }

        // Resaltar enlace activo
        const currentPath = window.location.pathname;
        for (let i = 0; i < links.length; i++) {
            const link = links[i];
            const linkPath = link.getAttribute('href') === '/home' ? '/' : link.getAttribute('href');
            const normalizedCurrentPath = currentPath === '/home' ? '/' : currentPath;
            if (linkPath === normalizedCurrentPath) {
                link.classList.add('active-link');
                break;
            }
        }
    });
</script>
