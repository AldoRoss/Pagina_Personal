<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- logo ico -->
    <link rel="icon" href="/images/Logo-Compress.png" type="image/x-icon" />
    <title>Aldo Ross</title>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <!-- SweetAlert CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- CDN Bootstrap icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Halant:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<script>
        document.addEventListener('DOMContentLoaded', function() {
        // Lógica para el menú de hamburguesa
        const hamburgerBtn = document.getElementById('hamburger-menu-btn');
        const navLinks = document.getElementById('nav-links');

        hamburgerBtn.addEventListener('click', function() {
            navLinks.classList.toggle('active');
        });

        // Lógica para resaltar el enlace activo
        const currentPath = window.location.pathname;
        const links = navLinks.getElementsByTagName('a');

        for (let i = 0; i < links.length; i++) {
            const link = links[i];
            // Normalize path to handle homepage and trailing slashes
            const linkPath = link.getAttribute('href') === '/home' ? '/' : link.getAttribute('href');
            const normalizedCurrentPath = currentPath === '/home' ? '/' : currentPath;

            if (linkPath === normalizedCurrentPath) {
                link.classList.add('active-link');
                break; // Stop after finding the match
            }
        }
    });
</script>


<body>

<header class="header">
    <div class="header-container">
        <img src="/images/Logo-Compress.png" alt="Logo" class="header-logo">
        <button class="hamburger" id="hamburger-menu-btn">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav class="nav-menu" id="nav-links">
            <a href="/home" class="nav-link">Inicio</a>
            <a href="/information" class="nav-link">Información</a>
            <a href="/projects" class="nav-link">Proyectos</a>
            <a href="/photos" class="nav-link">Fotos</a>
        </nav>
    </div>
</header>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Halant:wght@300;400;500;600;700&display=swap');
    /* Estilos para el header */
    .header {
    width: 100%;            /* Ocupa todo el ancho */
    background-color: #fff; /* Fondo blanco */
    position: fixed;        /* Fijo en la parte superior */
    top: 0;                 /* Pegado arriba */
    left: 0;                /* Pegado a la izquierda */
    padding: 10px 0;        /* Espaciado vertical */
    box-shadow: 0 2px 5px rgba(249, 84, 84, 0.1); /* Sombra inferior */
    z-index: 1000;
    }

    /* Contenedor del header */
    .header-container {
    display: flex;
    justify-content: space-between; /* Separa el logo y los enlaces */
    align-items: center;
    width: 90%;      /* Ancho del contenido */
    margin: 0 auto;  /* Centrar en la pantalla */
    }

    /* Logo */
    .header-logo {
    width: 80px; /* Ajusta el tamaño del logo */
    height: auto;
    }

    /* Menú de navegación */
    .nav-menu {
    display: flex;
    gap: 60px; /* Espacio entre los enlaces */
    }

    /* Estilos de los enlaces */
    .nav-link {
    text-decoration: none;
    color: #213555; /* Color del texto */
    font-size: 28px;
    font-weight: bold;
    font-family: 'Halant', serif;
    transition: color 0.3s ease;
    }

    .nav-link:hover {
    color: #F95454; /* Cambia de color al pasar el mouse */
    transform: translateY(-5px);
    }

    .nav-link.active-link {
    color: #F95454; /* Salmon color */
    font-weight: 700; 
}

    /* Estilos para el botón de hamburguesa (oculto en escritorio) */
.hamburger {
    display: none; /* Oculto por defecto */
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.hamburger .bar {
    display: block;
    width: 25px;
    height: 3px;
    background-color: #213555;
    margin: 5px 0;
    transition: all 0.3s ease-in-out;
}

/* Estilos responsivos */
@media screen and (max-width: 768px) {
    .header-container {
        justify-content: space-between;
    }
    
    .nav-menu {
        display: none; /* Oculta el menú de navegación */
        flex-direction: column;
        width: 100%;
        position: absolute;
        top: 60px; /* Debajo del header */
        left: 0;
        background-color: #fff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-align: center;
        padding: 20px 0;
        z-index: 999;
    }

    .nav-menu.active {
        display: flex; /* Muestra el menú cuando tiene la clase 'active' */
    }

    .nav-link {
        padding: 10px 0;
        font-size: 20px;
    }
    
    .hamburger {
        display: block; /* Muestra el botón de hamburguesa */
    }
}

</style>
